# MediSentinel Backend Configuration
# Copy to backend/.env and fill in real values. Never commit backend/.env.

APP_ENV=development

# PostgreSQL connection string (matches the docker run command in README / Step 1):
DATABASE_URL=postgresql+psycopg://medisentinel:medisentinel_dev@localhost:5432/medisentinel
# Optional local SQLite fallback when Docker/PostgreSQL is unavailable:
# DATABASE_URL=sqlite:///./medisentinel.db

# Scanner mode: "mock" (cached JSON) | "tinyfish_rest" | "tinyfish_sdk"
SCANNER_MODE=mock
TINYFISH_API_KEY=
TINYFISH_API_URL=https://agent.tinyfish.ai/v1/automation/run-sse
SCANNER_TIMEOUT_SECONDS=90.0
SCANNER_MAX_RETRIES=3
SCANNER_BACKOFF_SECONDS=1.5
# Demo resilience switch: if a live TinyFish run cannot initialize or a site fails,
# retry only the failed sites from deterministic cached JSON and disclose fallback in the response.
CACHED_RUN_FALLBACK=false

# Core Rule 4: flag potential discrepancy when MRP/unit exceeds allowed/unit by > tolerance %
DISCREPANCY_TOLERANCE_PERCENT=1.0

# Paths (resolved relative to backend/ unless absolute)
DATA_DIR=./data
CACHED_SCANS_DIR=./data/cached_scans
EVIDENCE_DIR=../storage/evidence

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
