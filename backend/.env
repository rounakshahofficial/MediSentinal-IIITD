# MediSentinel Backend Configuration
APP_ENV=development

# Local SQLite database (portable, no Docker required)
DATABASE_URL=sqlite:///./medisentinel.db

# Live TinyFish scanner configuration
SCANNER_MODE=tinyfish_rest
TINYFISH_API_KEY=sk-tinyfish-bR1coPBfCMGw-PKHxQfB_5uMbure8hMz
TINYFISH_API_URL=https://agent.tinyfish.ai/v1/automation/run-sse
SCANNER_TIMEOUT_SECONDS=90.0
SCANNER_MAX_RETRIES=3
SCANNER_BACKOFF_SECONDS=1.5

# Demo resilience: falls back to cached scans if live run encounters network/rate-limit issues
CACHED_RUN_FALLBACK=true

# Flag potential discrepancy when MRP/unit exceeds allowed/unit by > tolerance %
DISCREPANCY_TOLERANCE_PERCENT=1.0

# Paths (anchored relative to backend/ by config.py)
DATA_DIR=./data
CACHED_SCANS_DIR=./data/cached_scans
EVIDENCE_DIR=../storage/evidence

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
